generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  // Profile Data - One True Source
  fullName    String?
  email       String?  @unique
  phone       String?
  username    String?  @unique
  password    String?
  walletAddress String? @unique
  isVerified  Boolean  @default(false)
  
  // Balances - Direct on User Model
  momoBalance   Float @default(0.00)
  walletBalance Float @default(0.00)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  verifiedAt  DateTime?
  
  // Relations
  orders           Order[]
  tradingAccounts  TradingAccount[]
  transactions     Transaction[]
  verificationToken String?
  verificationSentAt DateTime?

  withdrawals  Withdrawal[]
  deposits     Deposit[]
}

model TradingAccount {
  id          String   @id @default(uuid())
  accountType String   @default("LIVE")
  status      String   @default("PENDING")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  type      String   // BUY or SELL
  symbol    String
  volume    Float
  price     Float
  total     Float
  profit    Float?
  status    String   // FILLED, SOLD, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(uuid())
  type      TransactionType
  amount    Float
  price     Float?
  totalValue Float?
  timestamp DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId   String?
  token     Token?   @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  status        TransactionStatus @default(PENDING)
  paymentMethod String?
  externalId    String?  // Stripe/Flutterwave payment ID
  accountDetails String? // For withdrawals (bank account, mobile number)
  
}

model Token {
  id          String   @id @default(uuid())
  name        String   @default("MomoCoin")
  symbol      String   @default("MOMO")
  totalSupply String   @default("100000000000000")
  currentPrice Float   @default(1.00)
  isLocked    Boolean  @default(true)
  createdAt   DateTime @default(now())
  reserves    Reserve[]
  transactions Transaction[]
  priceHistory PriceHistory[]
  priceVolatility Float @default(0.02)
  lastPriceUpdate DateTime @default(now())
  volume24h   Float    @default(0)
}

model Reserve {
  id       String @id @default(uuid())
  tokenId  String
  balance  String @default("100000000000000")
  token    Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Float
  timestamp DateTime @default(now())
  tokenId   String
  token     Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  STATEMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// Add to your existing schema - AFTER the existing models

model Withdrawal {
  id            String   @id @default(uuid())
  userId        String
  userEmail     String
  userName      String
  amount        Float
  method        String   // bank, crypto, paypal, card
  status        String   // pending, processing, completed, rejected, cancelled
  
  // Bank details
  bankName          String?
  accountNumber     String?
  accountName       String?
  swiftCode         String?
  iban              String?
  routingNumber     String?
  bankAddress       String?
  beneficiaryAddress String?
  
  // Crypto details
  cryptoAddress     String?
  cryptoNetwork     String?
  
  // Other methods
  paypalEmail       String?
  cardLastFour      String?
  
  // Notes
  userNotes         String?  // Notes from user
  adminNotes        String?  // Notes from admin
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Deposit {
  id              String   @id @default(uuid())
  userId          String
  userEmail       String
  userName        String
  amount          Float
  method          String   // crypto, card, bank, etc.
  status          String   // pending, completed, failed
  
  // Crypto specific
  transactionHash String?
  fromAddress     String?
  toAddress       String?
  
  // Admin notes
  adminNotes      String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([transactionHash])
}