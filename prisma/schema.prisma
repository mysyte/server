generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(uuid())
  fullName           String?
  email              String?          @unique
  phone              String?
  username           String?          @unique
  password           String?
  walletAddress      String?          @unique
  isVerified         Boolean          @default(false)
  momoBalance        Float            @default(0.00)
  walletBalance      Float            @default(0.00)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  verifiedAt         DateTime?
  verificationToken  String?
  verificationSentAt DateTime?
  deposits           Deposit[]
  orders             Order[]
  tradingAccounts    TradingAccount[]
  transactions       Transaction[]
  withdrawals        Withdrawal[]
  isAdmin     Boolean  @default(false)
}

model MarketSettings {
  id           Int      @id @default(1)
  marketCap    Float
  volume24h    Float
  targetPrice  Float
  trendDirection String
  trendStrength Float
  isLocked     Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TradingAccount {
  id          String   @id @default(uuid())
  accountType String   @default("LIVE")
  status      String   @default("PENDING")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  type      String
  symbol    String
  volume    Float
  price     Float
  total     Float
  profit    Float?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id             String            @id @default(uuid())
  type           TransactionType
  amount         Float
  price          Float?
  totalValue     Float?
  timestamp      DateTime          @default(now())
  userId         String
  tokenId        String?
  status         TransactionStatus @default(PENDING)
  paymentMethod  String?
  externalId     String?
  accountDetails String?
  token          Token?            @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Token {
  id              String         @id @default(uuid())
  name            String         @default("MomoCoin")
  symbol          String         @default("MOMO")
  totalSupply     String         @default("100000000000000")
  currentPrice    Float          @default(1.00)
  isLocked        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  priceVolatility Float          @default(0.02)
  lastPriceUpdate DateTime       @default(now())
  volume24h       Float          @default(0)
  priceHistory    PriceHistory[]
  reserves        Reserve[]
  transactions    Transaction[]
}

model Reserve {
  id      String @id @default(uuid())
  tokenId String
  balance String @default("100000000000000")
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Float
  timestamp DateTime @default(now())
  tokenId   String
  token     Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id                 String   @id @default(uuid())
  userId             String
  userEmail          String
  userName           String
  amount             Float
  method             String
  status             String
  bankName           String?
  accountNumber      String?
  accountName        String?
  swiftCode          String?
  iban               String?
  routingNumber      String?
  bankAddress        String?
  beneficiaryAddress String?
  cryptoAddress      String?
  cryptoNetwork      String?
  paypalEmail        String?
  cardLastFour       String?
  userNotes          String?
  adminNotes         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Deposit {
  id              String   @id @default(uuid())
  userId          String
  userEmail       String
  userName        String
  amount          Float
  method          String
  status          String
  transactionHash String?
  fromAddress     String?
  toAddress       String?
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([transactionHash])
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  STATEMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}
